# Copy to .env and fill in. Never commit .env.
# Sandbox accounts and REST apps are created by hand: see scripts/setup_sandbox.md

# ---------- PayPal environment ----------
# Base URL for every PayPal REST call. Keep this on the sandbox host.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Where PayPal sends the buyer after approving or cancelling an order.
# Any HTTPS URL you control works for the spikes; the Buyer App URL later.
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=

# ---------- Merchant REST apps (one per sandbox Business account) ----------
# Key names are PAYPAL_MERCHANT_<KEY>_CLIENT_ID / _CLIENT_SECRET.
# <KEY> must match a merchant key in config/merchants/*.yaml.
PAYPAL_MERCHANT_NORTHWIND_CLIENT_ID=
PAYPAL_MERCHANT_NORTHWIND_CLIENT_SECRET=
PAYPAL_MERCHANT_BAYLINE_CLIENT_ID=
PAYPAL_MERCHANT_BAYLINE_CLIENT_SECRET=
PAYPAL_MERCHANT_KESTREL_CLIENT_ID=
PAYPAL_MERCHANT_KESTREL_CLIENT_SECRET=
PAYPAL_MERCHANT_ATTACKER_CLIENT_ID=
PAYPAL_MERCHANT_ATTACKER_CLIENT_SECRET=

# ---------- Provenant operator (liability pool, Payouts) ----------
PAYPAL_OPERATOR_CLIENT_ID=
PAYPAL_OPERATOR_CLIENT_SECRET=

# ---------- Sandbox buyers (Personal accounts) ----------
# Emails are used as Payouts receivers in spike S3. Never logged in full.
PAYPAL_BUYER_A_EMAIL=
PAYPAL_BUYER_B_EMAIL=

# ---------- Webhooks (spike S5, Phase 2) ----------
# Public HTTPS base URL of the deployed API (Render, or a tunnel during dev).
PUBLIC_API_BASE_URL=

# ---------- LLM providers (free tiers) ----------
# Groq (OpenAI-compatible) is primary, Google AI Studio (Gemini) secondary.
GROQ_API_KEY=
GEMINI_API_KEY=

# ---------- LLM roles ----------
# provider: groq | gemini. Use exact, pinned model ids (no "-latest" aliases) so recorded runs
# replay against the same model. List what your keys can use:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" https://generativelanguage.googleapis.com/v1beta/models
# Agreed mapping: planner and mandate on Groq gpt-oss-120b, extractor on a Groq Qwen model,
# vision on Gemini Flash, narrator on Gemini Flash-Lite, baseline on a different provider than
# the planner. Fallbacks are used on 429 or when a model's daily budget is spent.
LLM_PLANNER_PROVIDER=
LLM_PLANNER_MODEL=
LLM_PLANNER_FALLBACK_PROVIDER=
LLM_PLANNER_FALLBACK_MODEL=
LLM_MANDATE_PROVIDER=
LLM_MANDATE_MODEL=
LLM_MANDATE_FALLBACK_PROVIDER=
LLM_MANDATE_FALLBACK_MODEL=
LLM_EXTRACTOR_PROVIDER=
LLM_EXTRACTOR_MODEL=
LLM_EXTRACTOR_FALLBACK_PROVIDER=
LLM_EXTRACTOR_FALLBACK_MODEL=
LLM_VISION_PROVIDER=
LLM_VISION_MODEL=
LLM_VISION_FALLBACK_PROVIDER=
LLM_VISION_FALLBACK_MODEL=
LLM_NARRATOR_PROVIDER=
LLM_NARRATOR_MODEL=
LLM_NARRATOR_FALLBACK_PROVIDER=
LLM_NARRATOR_FALLBACK_MODEL=
LLM_REFERENCE_POLICY_PROVIDER=
LLM_REFERENCE_POLICY_MODEL=
LLM_REFERENCE_POLICY_FALLBACK_PROVIDER=
LLM_REFERENCE_POLICY_FALLBACK_MODEL=
LLM_BASELINE_PROVIDER=
LLM_BASELINE_MODEL=
LLM_BASELINE_FALLBACK_PROVIDER=
LLM_BASELINE_FALLBACK_MODEL=

# ---------- Storage ----------
DATABASE_URL=postgresql+psycopg://provenant:provenant@localhost:5432/provenant
POSTGRES_USER=provenant
POSTGRES_PASSWORD=provenant
POSTGRES_DB=provenant

# ---------- Safety switches ----------
# Every money movement needs a human click in the Ops Console unless true.
AUTO_REMEDY=false
LLM_SEED_GENERATOR_PROVIDER=
LLM_SEED_GENERATOR_MODEL=
LLM_SEED_GENERATOR_FALLBACK_PROVIDER=
LLM_SEED_GENERATOR_FALLBACK_MODEL=

# ---------- Merchant simulator ----------
# Base URL of the storefront simulator (merchants/app.py); each merchant lives under /m/<key>.
MERCHANTS_BASE_URL=
