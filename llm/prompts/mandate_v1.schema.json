    "forbidden_attributes": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["name", "values"],
                "properties": {"name": {"type": "string"},
                               "values": {"type": "array", "items": {"type": "string"}}}}
    },
    "max_unit_price": {"type": ["string", "null"]},
    "max_total": {"type": ["string", "null"]},
    "currency": {"type": "string"},
    "quantity": {"type": ["integer", "null"]},
    "merchant_allowlist": {"type": ["array", "null"], "items": {"type": "string"}},
    "ship_to_ref": {"type": ["string", "null"]},
    "preference": {"type": ["string", "null"], "enum": ["lowest_total", "best_reviewed", null]},
    "questions": {"type": "array", "items": {"type": "string"}}
  }
}
